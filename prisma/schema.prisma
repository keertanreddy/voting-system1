generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
}

model Candidate {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String
  votes       Vote[]
}

model Vote {
  id          String   @id @default(cuid())
  voterId     String   @unique
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  createdAt   DateTime @default(now())
}
